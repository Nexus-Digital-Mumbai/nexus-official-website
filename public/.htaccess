# Hostinger Apache/LiteSpeed: map extensionless URLs to generated documents.
Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddType application/xml .xml
RewriteEngine On
RewriteRule ^nexwarranty/?$ https://nexusdig.in/nexwarrenty [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} !^404$
RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html[?\s]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+)\.html$ /$1 [R=301,L]
RewriteRule ^(.+)/$ /$1 [R=301,L]
RewriteRule ^404$ - [R=404,L]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9/-]+)$ $1.html [END]
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|png|jpg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
